# ─── Netzwerk ────────────────────────────────────────────────────────────────
# Port, unter dem der Backend-Container erreichbar ist. Der externe Nginx Proxy
# Manager (z. B. 192.168.1.100) verweist als Upstream auf http://<host>:<HTTP_PORT>.
HTTP_PORT=8080

# Kommagetrennte IPs/Netze, denen X-Forwarded-* geglaubt wird (der Proxy).
FORWARDED_ALLOW_IPS=192.168.1.100

# Secure-Flag des Session-Cookies: auto = anhand X-Forwarded-Proto, sonst true/false.
COOKIE_SECURE=auto

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Signierschlüssel für Session-Cookies. Leer lassen -> wird beim ersten Start
# generiert und nach deploy/secret_key geschrieben.
SECRET_KEY=

# ─── Datenbank ───────────────────────────────────────────────────────────────
POSTGRES_USER=sidc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sidc
DATABASE_URL=postgresql+psycopg://sidc:change-me@db:5432/sidc

# ─── Redis (WebSocket-Backplane) ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Bootstrap-Admin (lokaler Login, beim Start idempotent angelegt) ─────────
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-12-chars

# ─── Kartendaten ─────────────────────────────────────────────────────────────
MAP_IMPORT_MAX_MB=2048

# ─── OIDC (optional; leer = deaktiviert, lokaler Login bleibt aktiv) ─────────
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
