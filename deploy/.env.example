# ─── Version ─────────────────────────────────────────────────────────────────
# Release-Tag des Backend-Images (ghcr.io/gerskyking/sidc---c2---command-control).
# Update = Tag ändern, `docker compose pull && docker compose up -d`. DB-Migrationen
# laufen beim Start automatisch. Verfügbare Tags: GitHub -> Packages / Releases.
# Tag-Varianten: 1.2.0 = fest (empfohlen für Produktion), 1.2 = folgt den Patch-Releases 1.2.x,
# latest = jeweils neuestes Release (Achtung: kann auch größere Änderungen bringen).
SIDC_IMAGE_TAG=1.5.0

# ─── Netzwerk ────────────────────────────────────────────────────────────────
# Port, unter dem der Backend-Container erreichbar ist. Der externe Nginx Proxy
# Manager (z. B. 192.168.1.100) verweist als Upstream auf http://<host>:<HTTP_PORT>.
HTTP_PORT=8080

# Kommagetrennte IPs/Netze, denen X-Forwarded-* geglaubt wird (der Proxy).
FORWARDED_ALLOW_IPS=192.168.1.100

# Secure-Flag des Session-Cookies: auto = anhand X-Forwarded-Proto, sonst true/false.
# In Produktion hinter TLS: fest auf "true" setzen (siehe deploy/MANUAL-STEPS.md).
COOKIE_SECURE=auto

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Signierschlüssel für Session-Cookies. Leer lassen -> wird beim ersten Start
# generiert und nach deploy/secret_key geschrieben.
SECRET_KEY=

# ─── Datenbank ───────────────────────────────────────────────────────────────
POSTGRES_USER=sidc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sidc
DATABASE_URL=postgresql+psycopg://sidc:change-me@db:5432/sidc

# ─── Redis (WebSocket-Backplane) ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Backup (pg_dump-Container, Volume 'backups') ────────────────────────────
BACKUP_KEEP=14          # wie viele Dumps behalten
BACKUP_INTERVAL=86400   # Sekunden zwischen Dumps (86400 = täglich)

# ─── Bootstrap-Admin (lokaler Login, beim Start idempotent angelegt) ─────────
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-12-chars

# Optional: neue Nutzer (lokal + OIDC-Erstlogin) automatisch dieser Gruppe zuordnen.
# Leer = aus. (Gruppe vorher im Admin-Bereich anlegen.)
DEFAULT_USER_GROUP=

# ─── Benachrichtigungen (Discord, ntfy, Matrix, Web-Push, E-Mail) ────────────
# Öffentliche Adresse der Seite – damit Benachrichtigungen einen Link enthalten (z. B. https://c2.example.org).
PUBLIC_URL=
# true = auch Dienste im LAN (selbst gehostetes ntfy/Gotify/Matrix) als Ziel erlauben. Standard: nur öffentliche Adressen.
NOTIFY_ALLOW_PRIVATE_HOSTS=false
# Brücke zu Discord/Matrix (Bot siehe Repo „SIDC - C2 - Command & Control-Bot“). Langer Zufallswert, leer = aus.
BRIDGE_TOKEN=
# Discord-Bot im Stack (Dienst discord-bot): Bot-Token aus dem Developer Portal. Leer = Bot bleibt aus.
DISCORD_TOKEN=
# Release-Tag des Bot-Images (ghcr.io/gerskyking/sidc---c2---command-control-bot)
BOT_IMAGE_TAG=1.0.0
# optional: Discord-ID des Bot-Besitzers (Standard: Besitzer der Discord-Anwendung) und Textbefehl-Präfix
DISCORD_OWNER_ID=
BOT_PREFIX=!
# E-Mail-Kanal (optional): ohne SMTP_HOST ist er in den Einstellungen ausgegraut.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Kartendaten ─────────────────────────────────────────────────────────────
MAP_IMPORT_MAX_MB=2048

# ─── Standardfarben der Straßen-Ebene (Hex #rrggbb) ──────────────────────────
# Nutzer können sie im Ebenen-Panel pro Browser überschreiben.
ROAD_COLOR_MAIN=#000000
ROAD_COLOR_SECONDARY=#4a2e14
ROAD_COLOR_PATH=#8c8c8c

# ─── Audit-Log-Aufbewahrung ───────────────────────────────────────────────────
# Einträge älter als N Tage werden einmal täglich automatisch gelöscht. 0 = aus
# (Log wächst unbegrenzt).
AUDIT_LOG_RETENTION_DAYS=180

# ─── OIDC (optional; leer = deaktiviert, lokaler Login bleibt aktiv) ─────────
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# true = Anzeigename bei jedem OIDC-Login aus dem Token übernehmen (name, sonst
# preferred_username) und in C2 sperren
OIDC_SYNC_DISPLAY_NAME=false

# ─── Anmeldung und Zugriff über OIDC-Gruppen (alles optional) ────────────────
# Ohne diese Werte verhält sich das Tool wie bisher: lokale Konten, OIDC ohne
# Gruppenprüfung, Rechte von Hand, Sitzung 7 Tage.
# Eine gesetzte Gruppenliste, die keine Gruppe nennt (z. B. nur ","), ist ein Fehler:
# Das Backend startet damit nicht.

# Angeforderte Scopes. Die E-Mail wird nur verwendet, wenn "email" hier steht.
# Datensparsam (ohne E-Mail), ggf. mit eigenem Gruppen-Scope des Providers:
#   OIDC_SCOPES=openid profile
OIDC_SCOPES=openid email profile
# Name des Claims im ID-Token, der die Gruppen der Person als Liste enthält.
OIDC_GROUPS_CLAIM=groups
# Zugangsgruppen (kommagetrennt): Nur wer mindestens eine davon im Token hat, kommt
# hinein; sonst Ablehnungsseite, kein Konto. Leer = jede angemeldete Person darf.
OIDC_REQUIRED_GROUPS=
# Rechtegruppen je Recht (kommagetrennt, mehrere möglich). Leer = Recht wird wie
# bisher von Hand im Admin-Bereich gepflegt. Gesetzt = jeder OIDC-Login setzt das
# Recht genau nach den Gruppen (fehlt die Gruppe, ist das Recht weg), und der
# Admin-Bereich sperrt es für OIDC-Konten. Der Start-Admin bleibt immer Admin.
# Jede Gruppe gibt nur ihr eigenes Recht: Techniker schließt "Karten verwalten"
# nicht ein, Admin nicht Missionsbau oder Zeus.
OIDC_ADMIN_GROUPS=
OIDC_MISSION_BUILDER_GROUPS=
OIDC_ZEUS_GROUPS=
OIDC_CREATE_PLANS_GROUPS=
OIDC_TECHNICIAN_GROUPS=
OIDC_MANAGE_MAPS_GROUPS=
# Name des Anmeldedienstes, wie ihn die Nutzer kennen (höchstens 40 Zeichen). Gesetzt
# steht er auf dem Anmeldeknopf ("Mit <Name> anmelden") und in den Hinweisen der
# Anmeldeseite. Leer = neutrale Texte wie bisher ("Mit OIDC anmelden").
#   OIDC_PROVIDER_NAME=Beispiel-Dienst
# Lokale Anmeldung: all = jedes lokale Konto (Standard); bootstrap-admin = nur der
# Start-Admin als Notfallzugang, das Formular liegt dann unter /?local=1.
# Erst umstellen, wenn die bestehenden Konten verbunden sind: Verbinden braucht eine
# lokale Anmeldung des jeweiligen Kontos.
LOCAL_LOGIN=all
# Sitzungsdauer in Stunden. 0 = SESSION_TTL_DAYS gilt (Standard 7 Tage). Kürzer
# heißt: entzogene Rechte wirken früher (sie werden beim Login abgeglichen).
SESSION_TTL_HOURS=0
